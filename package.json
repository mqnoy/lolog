{
  "name": "@mqnoy/lolog",
  "version": "1.0.0",
  "description": "Ease to logging your app with wrapping winston to own logger class which called Lolog",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mqnoy/lolog.git"
  },
  "keywords": [
    "logger",
    "logging",
    "pino",
    "typescript",
    "high-performance",
    "json-logger"
  ],
  "author": "mqnoy",
  "license": "MIT",
  "homepage": "https://github.com/mqnoy/lolog#readme",
  "bugs": {
    "url": "https://github.com/mqnoy/lolog/issues"
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@swc/core": "^1.11.1",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
